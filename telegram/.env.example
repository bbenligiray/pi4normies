# Copy to .env and fill in. See README.md for where these come from.

# From @BotFather.
TELEGRAM_BOT_TOKEN=
# From https://my.telegram.org/apps, for the local Bot API server.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional, defaults shown.
# JOB_IMAGE=ghcr.io/bbenligiray/pi4normies:latest
# JOB_LIFETIME_HOURS=24
# JOB_WARN_MINUTES=60
# Per job container:
# JOB_MEMORY=4g
# JOB_CPUS=2
# JOB_PIDS=4096
# JOB_SHM=1g
# JOB_NETWORK=pi4normies-jobs
# Speech-to-text model for voice messages (https://openrouter.ai/collections/speech-to-text-models):
# TRANSCRIBE_MODEL=openai/whisper-large-v3
