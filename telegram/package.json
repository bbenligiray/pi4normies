{
  "name": "pi4normies-telegram",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot that runs a throwaway pi4normies container per job",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:live": "node --test test/live.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "dockerode": "^5.0.1",
    "grammy": "^1.46.0",
    "marked": "^18.1.0",
    "tar-stream": "^3.2.2"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.5",
    "@types/tar-stream": "^3.1.5",
    "typescript": "^7.0.2"
  }
}
